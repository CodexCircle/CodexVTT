<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>codexvtt-runtime-probe</AssemblyName>
    <RootNamespace>CodexVtt.Spike.RuntimeProbe</RootNamespace>
    <!-- Codice di spike: analisi standard, senza warning bloccanti. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-default</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Whisper.net" />
    <PackageReference Include="Whisper.net.Runtime" />
  </ItemGroup>

</Project>
