{
  "name": "codexvtt-ui",
  "private": true,
  "version": "2.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:app": "tsc --noEmit && vite build --outDir ../src/CodexVtt.App/Resources/Raw/wwwroot --emptyOutDir",
    "build:server": "tsc --noEmit && vite build --mode server --outDir ../src/CodexVtt.Server/wwwroot --emptyOutDir",
    "build:preview": "tsc --noEmit && vite build --mode preview --outDir dist-preview --emptyOutDir && node scripts/inline-preview.mjs dist-preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.13.0",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
